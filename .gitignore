# Environment
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Benchmark Run outputs and batch reports: large, machine-specific, and
# regenerated by running the program. The model library keeps user-owned
# naming in models/library.json, which is also local.
runs/
reports/
models/library.json
models/imported/

# Downloaded pretrained weights (TabPFN v2, ~45 MB), fetched on first use.
pretrained/

# Per-machine preferences, such as the chosen interface language.
settings.json

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Packaged-exe build: build environment, PyInstaller work folders and the
# release archives. Start-up and crash logs are per machine.
.venv-build/
build/
dist/
release/
logs/
